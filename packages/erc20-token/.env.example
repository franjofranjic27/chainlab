# Kopiere diese Datei zu `.env` und fuelle die Werte aus.
# `.env` ist git-ignoriert — echte Secrets niemals committen.

# JSON-RPC-Endpoint fuer das Sepolia-Testnet (z. B. von Alchemy oder Infura).
SEPOLIA_RPC_URL=

# Private Key des Deployer-Accounts (mit Sepolia-Test-ETH).
# Format: 0x-prefixed Hex. Nur ein Wegwerf-Testnet-Key, niemals ein echter!
SEPOLIA_PRIVATE_KEY=
